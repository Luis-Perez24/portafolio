---
import type { Site } from '../content/site';

interface Props {
  site: Site;
}

const { site } = Astro.props;
---

<section class="bg-blueprint-grid border-b border-grid">
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-24">
    <p class="font-mono text-sm text-ink/70">// {site.name.toLowerCase()}</p>

    <h1 class="mt-4 font-display text-4xl font-semibold uppercase tracking-tight sm:text-5xl md:text-6xl">
      {site.name}
    </h1>

    <p class="mt-3 font-mono text-base text-ink/90 sm:text-lg">{site.title}</p>

    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink/90">{site.heroPitch}</p>

    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a
        href="#proyectos"
        class="inline-flex items-center gap-2 border border-ink bg-ink px-5 py-3 font-mono text-sm text-canvas transition hover:bg-transparent hover:text-ink"
      >
        ver proyectos -&gt;
      </a>
      {
        site.cvPath && (
          <a
            href={site.cvPath}
            download
            class="inline-flex items-center gap-2 border border-ink px-5 py-3 font-mono text-sm text-ink transition hover:bg-ink hover:text-canvas"
          >
            descargar cv
          </a>
        )
      }
    </div>
  </div>
</section>
