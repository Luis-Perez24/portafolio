---
import type { Site } from '../content/site';

interface Props {
  site: Site;
}

const { site } = Astro.props;
---

<section
  id="inicio"
  class="relative overflow-hidden border-b border-v3-line"
  data-reveal-group
>
  <div class="v3-glow v3-parallax absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-24">
    <p
      class="font-v3-mono text-[11px] uppercase tracking-[0.28em] text-v3-accent"
      data-reveal
      style="--reveal-i: 0"
    >
      {site.title}
    </p>

    <h1
      class="mt-8 font-bold leading-[0.9] tracking-tighter text-v3-ink"
      data-reveal
      style="font-size: clamp(3rem, 11vw, 7rem); --reveal-i: 1"
    >
      {site.name}
    </h1>

    <p
      class="mt-8 max-w-2xl text-xl font-light leading-relaxed text-v3-muted"
      data-reveal
      style="--reveal-i: 2"
    >
      {site.heroPitch}
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-4" data-reveal style="--reveal-i: 3">
      <a
        href="#proyectos"
        class="v3-action inline-flex items-center rounded-md bg-v3-accent px-6 py-3 font-v3-mono text-xs uppercase tracking-[0.14em] text-v3-bg hover:bg-v3-ink"
      >
        Ver proyectos
      </a>
      {
        site.cvPath && (
          <a
            href={site.cvPath}
            download
            class="v3-action v3-action-outline inline-flex items-center rounded-md border border-v3-line px-6 py-3 font-v3-mono text-xs uppercase tracking-[0.14em] text-v3-ink"
          >
            Descargar CV
          </a>
        )
      }
    </div>
  </div>
</section>
