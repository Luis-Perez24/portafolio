---
/**
 * Mismo patrón accesible que la V2 (botón de dos estados con `aria-pressed`),
 * con el vocabulario visual de esta variante: pastilla llena sobre la
 * superficie elevada y etiqueta en mono con tracking abierto.
 */
---

<button
  type="button"
  data-theme-toggle
  aria-pressed="true"
  class="inline-flex items-center gap-2 rounded-md border border-v3-line bg-v3-surface px-3 py-1.5 font-v3-mono text-[11px] uppercase tracking-[0.14em] text-v3-muted transition-colors duration-200 hover:border-v3-accent hover:text-v3-accent"
>
  <svg
    class="v3-icon-light size-4"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg
    class="v3-icon-dark size-4"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a7 7 0 1 0 10.5 10.5Z"></path>
  </svg>

  <span class="v3-icon-light" aria-hidden="true">día</span>
  <span class="v3-icon-dark" aria-hidden="true">noche</span>
  <span class="sr-only">Modo noche</span>
</button>
