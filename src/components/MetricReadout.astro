---
import type { Metric } from '../content/site';

interface Props {
  metric: Metric;
}

const { metric } = Astro.props;
const numericValue = Number(metric.value);
const isNumeric = !Number.isNaN(numericValue);
---

<div
  class="metric-readout"
  data-metric-readout
  data-metric-value={isNumeric ? numericValue : undefined}
>
  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
    <span
      class="font-mono text-5xl font-semibold tabular-nums text-ok"
      data-metric-number
    >
      {isNumeric ? '0' : metric.value}
    </span>
    <span class="text-sm text-ink/80">{metric.label}</span>
  </div>

  {
    metric.distribution && (
      <div
        class="mt-3 flex flex-wrap items-center gap-1"
        role="img"
        aria-label={metric.detail ?? metric.label}
      >
        {metric.distribution.map((group) =>
          Array.from({ length: group.count }).map(() => (
            <span
              class:list={[
                'h-2 w-2 rounded-full opacity-0 transition-opacity duration-300',
                group.color === 'ok' ? 'bg-ok' : 'bg-flag',
              ]}
              data-metric-dot
              aria-hidden="true"
            />
          )),
        )}
      </div>
    )
  }

  {metric.detail && <p class="mt-2 font-mono text-xs text-ink/70">{metric.detail}</p>}
</div>

<script>
  const readouts = document.querySelectorAll<HTMLElement>('[data-metric-readout]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  readouts.forEach((el) => {
    const targetRaw = el.dataset.metricValue;
    const target = targetRaw !== undefined ? Number(targetRaw) : null;
    const numberEl = el.querySelector<HTMLElement>('[data-metric-number]');
    const dots = Array.from(el.querySelectorAll<HTMLElement>('[data-metric-dot]'));

    function reveal() {
      dots.forEach((dot, i) => {
        dot.style.transitionDelay = reduceMotion ? '0ms' : `${Math.min(i * 4, 400)}ms`;
        dot.classList.remove('opacity-0');
      });

      if (target === null || !numberEl) return;
      if (reduceMotion || target === 0) {
        numberEl.textContent = String(target);
        return;
      }

      const durationMs = 600;
      const start = performance.now();

      function tick(now: number) {
        const progress = Math.min((now - start) / durationMs, 1);
        numberEl!.textContent = String(Math.round(progress * (target as number)));
        if (progress < 1) requestAnimationFrame(tick);
      }

      requestAnimationFrame(tick);
    }

    if (reduceMotion) {
      reveal();
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            reveal();
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.4 },
    );

    observer.observe(el);
  });
</script>
