---
interface Props {
  paragraphs: string[];
}

const { paragraphs } = Astro.props;
---

<section id="sobre-mi" aria-labelledby="titulo-sobre-mi" class="border-t border-grid bg-panel/50">
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <p class="font-mono text-sm text-ink/70">// 03</p>
    <h2 id="titulo-sobre-mi" class="mt-2 font-display text-3xl font-semibold uppercase tracking-tight">
      Sobre mí
    </h2>

    <div class="mt-8 max-w-2xl space-y-4 text-lg leading-relaxed text-ink/90">
      {paragraphs.map((line) => <p>{line}</p>)}
    </div>
  </div>
</section>
