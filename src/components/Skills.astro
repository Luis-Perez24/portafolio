---
interface Props {
  primary: string[];
  secondary: string[];
}

const { primary, secondary } = Astro.props;
---

<section id="skills" aria-labelledby="titulo-skills" class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
  <p class="font-mono text-sm text-ink/70">// 02</p>
  <h2 id="titulo-skills" class="mt-2 font-display text-3xl font-semibold uppercase tracking-tight">
    Skills
  </h2>

  <ul class="mt-8 flex flex-wrap gap-2">
    {
      primary.map((skill) => (
        <li class="border border-ink/30 bg-panel px-3 py-1.5 font-mono text-sm text-ink">
          {skill}
        </li>
      ))
    }
  </ul>

  <p class="mt-6 font-mono text-sm text-ink/70">también trabajo con: {secondary.join(' · ')}</p>
</section>
