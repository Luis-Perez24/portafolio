---
import Base from '../layouts/Base.astro';
import { site, projects } from '../content/site';

const liveProjects = projects.filter((project) => project.status === 'live');
const wipProjects = projects.filter((project) => project.status === 'wip');
---

<Base title={`${site.name} · ${site.title}`} description={site.heroPitch}>
  <div class="mx-auto max-w-3xl px-4 py-10">
    <header>
      <nav aria-label="Secciones">
        <ul>
          <li><a href="#proyectos">Proyectos</a></li>
          <li><a href="#skills">Skills</a></li>
          <li><a href="#sobre-mi">Sobre mí</a></li>
          <li><a href="#contacto">Contacto</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <section aria-labelledby="titulo">
        <h1 id="titulo">{site.name}</h1>
        <p>{site.title}</p>
        <p>{site.heroPitch}</p>
        <ul>
          <li><a href="#proyectos">Ver proyectos</a></li>
          {site.cvPath && <li><a href={site.cvPath} download>Descargar CV</a></li>}
          <li><a href={site.github} rel="me noopener">GitHub</a></li>
          {site.linkedin && <li><a href={site.linkedin} rel="me noopener">LinkedIn</a></li>}
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        </ul>
      </section>

      <section id="proyectos" aria-labelledby="titulo-proyectos">
        <h2 id="titulo-proyectos">Proyectos</h2>

        {
          liveProjects.map((project) => (
            <article>
              <h3>{project.name}</h3>
              <p>{project.tagline}</p>

              {project.metric && (
                <p>
                  <strong>{project.metric.value}</strong> {project.metric.label}
                  {project.metric.detail && <span> ({project.metric.detail})</span>}
                </p>
              )}

              <h4>Decisiones técnicas</h4>
              <ul>
                {project.decisions.map((decision) => (
                  <li>{decision}</li>
                ))}
              </ul>

              <h4>Stack</h4>
              <ul>
                {project.stack.map((tech) => (
                  <li>{tech}</li>
                ))}
              </ul>

              <ul>
                {project.repos.map((repo) => (
                  <li>
                    <a href={repo.url} rel="noopener">
                      {repo.label}
                    </a>
                  </li>
                ))}
                {project.videoUrl && (
                  <li>
                    <a href={project.videoUrl} rel="noopener">
                      Ver demo (60s)
                    </a>
                  </li>
                )}
                {project.demoUrl && (
                  <li>
                    <a href={project.demoUrl} rel="noopener">
                      Ver demo
                    </a>
                  </li>
                )}
              </ul>
            </article>
          ))
        }

        {
          wipProjects.map((project) => (
            <article>
              <h3>
                {project.name} <span>En desarrollo</span>
              </h3>
              <p>{project.tagline}</p>
              <ul>
                {project.stack.map((tech) => (
                  <li>{tech}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </section>

      <section id="skills" aria-labelledby="titulo-skills">
        <h2 id="titulo-skills">Skills</h2>
        <ul>
          {site.skillsPrimary.map((skill) => <li>{skill}</li>)}
        </ul>
        <p>También trabajo con: {site.skillsSecondary.join(' · ')}</p>
      </section>

      <section id="sobre-mi" aria-labelledby="titulo-sobre-mi">
        <h2 id="titulo-sobre-mi">Sobre mí</h2>
        {site.about.map((line) => <p>{line}</p>)}
      </section>

      <section id="contacto" aria-labelledby="titulo-contacto">
        <h2 id="titulo-contacto">Contacto</h2>
        <ul>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={site.github} rel="me noopener">GitHub</a></li>
          {site.linkedin && <li><a href={site.linkedin} rel="me noopener">LinkedIn</a></li>}
          {site.cvPath && <li><a href={site.cvPath} download>Descargar CV</a></li>}
        </ul>
      </section>
    </main>

    <footer>
      <p>
        Hecho con Astro · <a href={site.repoUrl} rel="noopener">ver el código</a>
      </p>
    </footer>
  </div>
</Base>
