---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectTeaser from '../components/ProjectTeaser.astro';
import Skills from '../components/Skills.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import { site, projects } from '../content/site';

const liveProjects = projects.filter((project) => project.status === 'live');
const wipProjects = projects.filter((project) => project.status === 'wip');
---

<Base title={`${site.name} · ${site.title}`} description={site.heroPitch}>
  <a
    href="#contenido"
    class="sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:left-4 focus-visible:top-4 focus-visible:z-50 focus-visible:border focus-visible:border-ink focus-visible:bg-canvas focus-visible:px-4 focus-visible:py-2 focus-visible:font-mono focus-visible:text-sm"
  >
    saltar al contenido
  </a>

  <header class="sticky top-0 z-10 border-b border-grid bg-canvas/95 backdrop-blur">
    <nav
      aria-label="Secciones"
      class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-4 py-4 sm:px-6"
    >
      <span class="font-display text-sm font-semibold uppercase tracking-wide">{site.name}</span>
      <ul class="flex flex-wrap gap-x-5 gap-y-1 font-mono text-xs uppercase tracking-wide text-ink/70">
        <li><a href="#proyectos" class="hover:text-ink">proyectos</a></li>
        <li><a href="#skills" class="hover:text-ink">skills</a></li>
        <li><a href="#sobre-mi" class="hover:text-ink">sobre mí</a></li>
        <li><a href="#contacto" class="hover:text-ink">contacto</a></li>
      </ul>
    </nav>
  </header>

  <main id="contenido">
    <Hero site={site} />

    <section id="proyectos" aria-labelledby="titulo-proyectos" class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
      <p class="font-mono text-sm text-ink/70">// 01</p>
      <h2 id="titulo-proyectos" class="mt-2 font-display text-3xl font-semibold uppercase tracking-tight">
        Proyectos
      </h2>

      <div class="mt-10 grid gap-8">
        {liveProjects.map((project) => <ProjectCard project={project} />)}
      </div>

      {
        wipProjects.length > 0 && (
          <div class="mt-8 grid gap-4">
            {wipProjects.map((project) => (
              <ProjectTeaser project={project} />
            ))}
          </div>
        )
      }
    </section>

    <Skills primary={site.skillsPrimary} secondary={site.skillsSecondary} />
    <About paragraphs={site.about} />
  </main>

  <Contact site={site} />
</Base>
